import { useState } from "react";
import "./App.css";

function App() {
  const [task, setTask] = useState("");
  const [tasks, setTasks] = useState([]);

  return (
    <div className="box">
      <h1>📝 To Do List</h1>

      <input
        value={task}
        onChange={(e) => setTask(e.target.value)}
        placeholder="Enter Task"
      />

      <button onClick={() => {
        if (task) {
          setTasks([...tasks, task]);
          setTask("");
        }
      }}>
        Add
      </button>

      {tasks.map((t, i) => (
        <p key={i}>
          {t}
          <button onClick={() => setTasks(tasks.filter((_, j) => i !== j))}>
            ❌
          </button>
        </p>
      ))}
    </div>
  );
}

export default App;

