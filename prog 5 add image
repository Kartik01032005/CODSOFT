import { useState } from "react";
import "./App.css";

function App() {
  const [img, setImg] = useState([
    "https://picsum.photos/200",
    "https://picsum.photos/201"
  ]);

  return (
    <div className="box">
      <h1>Image Gallery</h1>

      <button onClick={() => setImg([...img, "https://picsum.photos/200"])}>
        Add
      </button>

      <button onClick={() => setImg(img.slice(0, -1))}>
        Remove
      </button>

      <div className="grid">
        {img.map((x, i) => (
          <div key={i}>
            <img src={x} alt="" />
            <p>Image {i + 1}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

export default App;

